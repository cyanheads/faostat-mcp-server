{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "faostat-mcp-server",
  "version": "0.5.0",
  "description": "Global food & agriculture statistics from the UN FAOSTAT bulk-download corpus, served from a local SQLite mirror with a DataCanvas SQL surface, via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/faostat-mcp-server",
  "repository": "https://github.com/cyanheads/faostat-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "faostat",
    "fao",
    "agriculture",
    "food-security",
    "agricultural-statistics",
    "crop-production",
    "agricultural-trade",
    "food-balances",
    "duckdb",
    "sqlite",
    "dataframe"
  ],
  "mcpServers": {
    "faostat-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/faostat-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
